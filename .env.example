# Example Environment Configuration for QueueCare
# Copy this file to .env.local for local overrides. Never commit actual secret keys to version control.

# Application Information
VITE_APP_TITLE=QueueCare
VITE_HOSPITAL_NAME=QueueCare General Hospital

# Backend API / WebSocket Endpoints (if connecting to an external server)
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_WS_URL=ws://localhost:8000/ws

# Feature Flags
VITE_ENABLE_AUDIO_ANNOUNCEMENTS=true
VITE_ENABLE_QR_VERIFICATION=true
